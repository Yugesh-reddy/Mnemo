# Copy to .env and adjust. All settings are read by mnemo/config.py (env prefix: MNEMO_).

# --- Database ---
MNEMO_DSN=postgresql://mnemo:mnemo@localhost:5432/mnemo
# Disposable DB used by the test suite (see tests/conftest.py).
MNEMO_TEST_DSN=postgresql://mnemo:mnemo@localhost:5432/mnemo_test

# --- Embedding / LLM backend: "ollama" (default, local & free) or "openai" ---
MNEMO_BACKEND=ollama

# --- Ollama (default backend) ---
MNEMO_OLLAMA_HOST=http://localhost:11434
MNEMO_EMBED_MODEL=nomic-embed-text
MNEMO_EMBED_DIM=768
MNEMO_EXTRACTOR_MODEL=llama3.2:3b

# --- OpenAI (set MNEMO_BACKEND=openai to use) ---
# A fresh database renders the configured dimension during initial migration.
# An existing database requires an explicit dimension migration and re-embedding;
# startup rejects a dimension mismatch. Do not edit already-applied migrations.
# OPENAI_API_KEY=sk-...
# MNEMO_EMBED_MODEL=text-embedding-3-small
# MNEMO_EMBED_DIM=1536
# MNEMO_EXTRACTOR_MODEL=gpt-4o-mini

# --- Thresholds (spec §5; covered by tests) ---
MNEMO_UPDATE_SIM=0.90        # legacy setting; structured values govern updates now
MNEMO_DEDUP_SIM=0.92         # legacy setting; aliases and exact values govern dedup
MNEMO_CONFIDENCE_FLOOR=0.5   # drop extracted facts below this confidence

# --- Quality gate (spec §4 Layer 2 / §13; tune only against `make eval`) ---
MNEMO_W_IMP=0.4              # write_score weight: importance/10
MNEMO_W_SPEC=0.3             # write_score weight: predicate-in-vocabulary
MNEMO_W_NOV=0.3              # write_score weight: novelty (1 - max cosine)
MNEMO_W_SRC=0.4              # regression score term; worker excludes assistants in code
MNEMO_TRANSIENT_PENALTY=0.15 # penalty for explicitly transient turns
MNEMO_DURABLE_CUTOFF=0.70    # score >= this => durable; below => session
MNEMO_EPHEMERAL_FLOOR=0.45   # below-floor important facts/corrections still become session
# List envs use JSON syntax, e.g.:
# MNEMO_PREDICATE_VOCAB='["name","role","preferred_database","timezone"]'

# --- Full semantic verification (install with uv sync --extra dev --extra nli) ---
# Heuristic is the default regression mode, with limited predicate coverage.
# MNEMO_VERIFIER_BACKEND=cross_encoder
# MNEMO_VERIFIER_MODEL=cross-encoder/nli-deberta-v3-small
# MNEMO_VERIFIER_FALLBACK_BACKEND=ollama
# MNEMO_VERIFIER_ENTAILMENT_THRESHOLD=0.99

# --- Worker and retention ---
MNEMO_WORKER_ENABLED=true    # set false in MCP when running a separate make worker
MNEMO_JOB_LEASE_SECONDS=60
MNEMO_JOB_MAX_ATTEMPTS=3
MNEMO_DECAY_INTERVAL_SECONDS=3600
MNEMO_SESSION_TTL_SECONDS=86400
MNEMO_SEARCH_HNSW_MAX_SCAN_TUPLES=20000
MNEMO_NAMESPACE=default
MNEMO_USER_ID=default
MNEMO_AGENT_ID=default
