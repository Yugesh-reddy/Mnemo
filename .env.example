# Copy to .env and adjust. All settings are read by mnemo/config.py (env prefix: MNEMO_).

# --- Database ---
# Postgres host port for `make up` (localhost only). If 5432 is taken, set e.g. 5433;
# the default DSNs below follow it unless you set them explicitly.
# MNEMO_DB_PORT=5432
# Set these only for another server; by default they follow MNEMO_DB_PORT.
# MNEMO_DSN=postgresql://mnemo:mnemo@localhost:5432/mnemo
# Disposable DB used by the test suite (see tests/conftest.py).
# MNEMO_TEST_DSN=postgresql://mnemo:mnemo@localhost:5432/mnemo_test

# --- Backend: "ollama" (default), "local" (model inside Mnemo), "openai", or "hash" ---
MNEMO_BACKEND=ollama
# local: an ONNX model runs in the server process; `mnemo install --backend local`
# downloads it. Default BAAI/bge-small-en-v1.5 (384 dimensions, needs a new database).
# MNEMO_BACKEND=local
# MNEMO_EMBED_MODEL=BAAI/bge-small-en-v1.5
# MNEMO_MODEL_DIR=~/.mnemo/models
# For direct writes/demos with no model server:
# MNEMO_BACKEND=hash
# Hash vectors do not measure meaning; keyword search remains available.

# --- Ollama (default backend) ---
MNEMO_OLLAMA_HOST=http://localhost:11434
MNEMO_EMBED_MODEL=nomic-embed-text
MNEMO_EMBED_DIM=768

# --- OpenAI (set MNEMO_BACKEND=openai to use) ---
# A fresh database renders the configured dimension during initial migration.
# An existing database requires an explicit dimension migration and re-embedding;
# startup rejects a dimension mismatch. Do not edit already-applied migrations.
# OPENAI_API_KEY=sk-...
# MNEMO_EMBED_MODEL=text-embedding-3-small
# MNEMO_EMBED_DIM=1536

# --- Optional Azure Luna host for the direct-memory pilot only ---
# Accepts a Foundry project URL or the resource's /openai/v1/ URL.
# MNEMO_AZURE_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# MNEMO_AZURE_DEPLOYMENT=your-luna-deployment-name
# AZURE_OPENAI_API_KEY=
# uv run python -m examples.agent_undo --host azure --output docs/direct-pilot/new-luna-run
# Does not switch the embedding backend or alter the existing database.

# --- Search and scope ---
MNEMO_SESSION_TTL_SECONDS=86400
MNEMO_SEARCH_HNSW_MAX_SCAN_TUPLES=20000
MNEMO_NAMESPACE=default
MNEMO_USER_ID=default
MNEMO_AGENT_ID=default
# Direct MCP server (mnemo-mcp-direct): set a different actor per coding agent
# (claude-code, codex, ...) and leave MNEMO_AGENT_ID shared so they read one memory.
# MNEMO_ACTOR=claude-code
# The project scope is detected from the server's git repository; override with:
# MNEMO_PROJECT=github.com/you/your-repo
