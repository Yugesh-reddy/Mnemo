diff --git a/tests/test_extraction_spans.py b/tests/test_extraction_spans.py
new file mode 100644
index 0000000..abb4759
--- /dev/null
+++ b/tests/test_extraction_spans.py
@@ -0,0 +1,103 @@
+"""Evidence selection copies trusted input and never grants semantic authority."""
+
+import json
+
+import pytest
+
+from mnemo.extraction import ExtractionWorker, OllamaExtractor, OpenAIExtractor
+from mnemo.quality import Verdict
+
+SOURCE = "Résumé: Mina lent me a camera on Monday, and I returned it.\nI may buy one later."
+
+
+@pytest.mark.parametrize("provider", [OllamaExtractor, OpenAIExtractor])
+def test_selected_span_is_copied_exactly_without_model_reproducing_punctuation(provider):
+    extractor = provider(
+        max_retries=0, **({"api_key": "stub"} if provider is OpenAIExtractor else {})
+    )
+    extractor._chat = lambda *args: json.dumps(
+        {
+            "facts": [
+                {
+                    "evidence_id": 0,
+                    "subject": "user",
+                    "predicate": "borrowed",
+                    "object": "camera from Mina on Monday, subsequently returned",
+                }
+            ]
+        }
+    )
+    try:
+        assert extractor.extract(SOURCE)[0].evidence == SOURCE.split("\n")[0]
+    finally:
+        extractor.close()
+
+
+@pytest.mark.parametrize("span_id", [True, -1, 1.5, "0", 999, None])
+def test_invalid_span_reference_cannot_fall_back_to_a_valid_supplied_quote(span_id):
+    raw = {
+        "facts": [
+            {
+                "evidence_id": span_id,
+                "evidence": SOURCE,
+                "subject": "user",
+                "predicate": "borrowed",
+                "object": "camera",
+            }
+        ]
+    }
+    with pytest.raises(ValueError, match="evidence_id"):
+        OllamaExtractor._parse(json.dumps(raw), SOURCE)
+
+
+def test_span_reference_does_not_silently_repair_conflicting_quote():
+    raw = {
+        "facts": [
+            {
+                "evidence_id": 1,
+                "evidence": "I bought one later.",
+                "subject": "user",
+                "predicate": "bought",
+                "object": "camera",
+            }
+        ]
+    }
+    with pytest.raises(ValueError, match="conflicts"):
+        OllamaExtractor._parse(json.dumps(raw), SOURCE)
+
+
+async def test_selected_source_span_still_requires_full_turn_semantic_verification(store, db):
+    extractor = OllamaExtractor(max_retries=0)
+    extractor._chat = lambda *args: json.dumps(
+        {
+            "facts": [
+                {
+                    "evidence_id": 0,
+                    "subject": "user",
+                    "predicate": "owns",
+                    "object": "camera",
+                }
+            ]
+        }
+    )
+
+    class RejectOwnership:
+        def verify(self, candidate, source):
+            assert source == SOURCE
+            assert candidate.evidence == SOURCE.split("\n")[0]
+            return Verdict(
+                accepted=False,
+                label="contradiction",
+                probability=1,
+                reason="Borrowing and returning do not establish ownership",
+                backend="stub",
+            )
+
+    try:
+        await store.observe("span-test", SOURCE, "s")
+        await ExtractionWorker(db, store.embedder, extractor, RejectOwnership()).process_one()
+    finally:
+        extractor.close()
+    assert await db.fetchval("SELECT status FROM extraction_job") == "done"
+    assert await db.fetchval("SELECT count(*) FROM memory_event") == 0
+    assert await db.fetchval("SELECT outcome FROM quality_decision") == "rejected"
